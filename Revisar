),

--TMP_TIENDAS 
TIENDA_2 AS (
  SELECT
    SAFE_CAST(TDA_CVE AS INT64) AS TDA_CVE,
    TDA_DES,
    TDA_ZNA1 AS TDA_ZNA,
    TIPO_TDA,
    TDA_EDO_CVE
  FROM (
    SELECT 
      *,
      CASE 
        WHEN TDA_CVE IN ('0039', '0782') THEN 'On-line'
        WHEN TDA_CVE IN ('0009','0956') THEN 'CAT'
        WHEN SUBSTR(TDA_DES,1,8)='Suburbia' AND ZONA_DES IS NOT NULL THEN ZONA_DES
        WHEN TDA_ZNA = '1' THEN "1. Metro Sur"
        WHEN TDA_ZNA = '2' THEN "2. Metro Norte"
        WHEN TDA_ZNA = '3' THEN "3. Centro"
        WHEN TDA_ZNA = '4' THEN "4. Occidente"
        WHEN TDA_ZNA = '5' THEN "5. Golfo"
        WHEN TDA_ZNA = '6' THEN "6. Noreste"
        WHEN TDA_ZNA = '7' THEN "7. Bajío"
        WHEN TDA_ZNA = '8' THEN "8. Noroeste"
        WHEN TDA_ZNA = '9' THEN "9. Sureste"
        WHEN TDA_ZNA = 'Bout' 
          OR TDA_DES LIKE '%Pottery%' 
          OR TDA_DES LIKE '%West%' 
          OR TDA_DES LIKE '%Sfera%' 
          OR TDA_DES LIKE '%Will%' 
          OR TDA_DES LIKE '%Banana%' 
          OR TDA_DES LIKE '%Gap%' 
          OR TDA_DES LIKE '%Toys%' THEN 'Boutiques'
        WHEN TDA_ZNA = 'Bode' OR TDA_DES LIKE '%Bode%' THEN 'Bodegas'
        ELSE 'No Identificada' 
      END AS TDA_ZNA1
    FROM (
      SELECT 
        COALESCE(a.TDA_CVE, b.TDA_CVE) AS TDA_CVE,
        COALESCE(INITCAP(a.TDA_DES), INITCAP(b.TDA_DES)) AS TDA_DES,
        INITCAP(a.TDA_ZNA) AS TDA_ZNA,
        INITCAP(b.ZONA_DES) AS ZONA_DES,
        a.TIPO_TDA,
        a.TDA_EDO_CVE
      FROM crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_TDA a
      FULL JOIN VDIM_NEGFIN_ZONAS_SBB b
      ON a.TDA_CVE = b.TDA_CVE
    )
  )
),

