SCORE AS (
	SELECT 
    * EXCEPT(rn)
  FROM (
		SELECT 
      *,
      ROW_NUMBER() OVER (PARTITION BY TRJ_NUM ORDER BY DT_FCH_OBS DESC) as rn
		FROM (
			SELECT 
        a.*,
				b.CTA_MISC_CR_SCORE,
        b.CTA_NUM_CIC_FAC,
