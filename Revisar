    END AS SC_N_VAR_03,
    CASE 
      WHEN BR_MODULO_SCORE_DES IN ('SC_CHALLENGER_DILISA','SC_CHALLENGER_DILISA_EMPLEADO','SC_CHALLENGER_SUBURBIA','SC_CHALLENGER_SUBURBIA_EMPLEADO')
