      THEN BR_NUM_FAM_ING_MENOR_2SM_CDP
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD1_THINREV_SIM','SCORECARD1_THINREV_SIM_SBB')
      THEN numRevOpenTL30pEver
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD2_THICKREVAGELT30_SIM','SCORECARD2_THICKREVAGELT30_SIM_SBB')
      THEN mosSncMostRcntDerog
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD3_THICKREVAGEGE30_SIM','SCORECARD3_THICKREVAGEGE30_SIM_SBB')
      THEN pctILTL
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_NOHITDILISA_CONTL_2020','SCORECARD_NOHITDILISA_CONTL_2020SEL')
      THEN BR_INC_CONSULTA_REVOL_ULT_9M
    END AS SC_N_VAR_13,
    CASE 
      WHEN BR_MODULO_SCORE_DES IN ('SC_LPC_HIT_DOBLES_PUROS_EMPLEADOS','SC_LPC_HIT_DOBLES_Y_PUROS','SC_VISA_SUBURBIA')
      THEN BR_IMP_MAX_SDO_GRAVE
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD1_THINREV_SIM','SCORECARD1_THINREV_SIM_SBB')
      THEN numTLOpnd0to11Mos
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD2_THICKREVAGELT30_SIM','SCORECARD2_THICKREVAGELT30_SIM_SBB')
      THEN netFrctTLOpnd0To11Mos
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD3_THICKREVAGEGE30_SIM','SCORECARD3_THICKREVAGEGE30_SIM_SBB')
      THEN pctTLOpnd0To11Mos
    END AS SC_N_VAR_14,
    CASE 
      WHEN BR_MODULO_SCORE_DES IN ('SC_LPC_HIT_DOBLES_PUROS_EMPLEADOS','SC_LPC_HIT_DOBLES_Y_PUROS','SC_VISA_SUBURBIA')
      THEN BR_RANK_LINEA2
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD1_THINREV_SIM','SCORECARD1_THINREV_SIM_SBB')
      THEN highestUtilOnRevTL
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD3_THICKREVAGEGE30_SIM','SCORECARD3_THICKREVAGEGE30_SIM_SBB')
      THEN msSncOldstBnkNatlRvOpnTLOp
    END AS SC_N_VAR_15,
    CASE 
      WHEN BR_MODULO_SCORE_DES IN ('SC_LPC_HIT_DOBLES_PUROS_EMPLEADOS','SC_LPC_HIT_DOBLES_Y_PUROS','SC_VISA_SUBURBIA')
      THEN BR_RANK_LINEA1
    END AS SC_N_VAR_16,
    CASE 
      WHEN BR_MODULO_SCORE_DES IN ('SC_LPC_HIT_DOBLES_PUROS_EMPLEADOS','SC_LPC_HIT_DOBLES_Y_PUROS','SC_VISA_SUBURBIA')
      THEN BR_IMP_LIM_CRED_MAYOR_4K
    END AS SC_N_VAR_17,
    CASE 
      WHEN BR_MODULO_SCORE_DES IN ('SC_LPC_HIT_DOBLES_PUROS_EMPLEADOS','SC_LPC_HIT_DOBLES_Y_PUROS','SC_VISA_SUBURBIA')
      THEN BR_IMP_AVG_MES_MORA
    END AS SC_N_VAR_18,
    CASE 
      WHEN TDA_CVE IN('0782','0039') THEN 'SEL'
      WHEN TDA_CVE NOT IN('0782','0039') AND BR_CANAL_CVE IN (8,9,10,11,12,13) THEN 'OCDT'
      ELSE 'TRAD' 
    END AS FUENTE
  FROM UNION_INFO
  ),

