      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_SUBURBIANOHIT_SINTL_2021','SCORECARD_SUBURBIANOHIT_SINTL_2021SEL')
      THEN BR_EDAD
      WHEN BR_MODULO_SCORE_DES IN (
