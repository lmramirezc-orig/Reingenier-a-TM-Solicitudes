ACTUALIZA_OTROS_VAL AS (
/* **********************************************************************
*****     ACTUALIZA LOS OTROS VALORES TMP_APIS_APIA_VAR             *****
********************************************************************** */
  SELECT 
    * EXCEPT(BR_HIT_DES, SEGMENTO_BC_PRE2020, SEGMENTO_BC_2020),
    CASE WHEN BR_TIPO IN (1001, 948, 9480, 9481, 949, 9490, 9491, 8491,1011,1031) THEN 'X-SELL' ELSE COALESCE(BR_HIT_DES, 'SIN HIT') END AS BR_HIT_DES,
    CASE WHEN SEGMENTO_BC_PRE2020 IS NULL AND FLG_IQ_MATCH = 1 THEN 'NOHIT' ELSE COALESCE(SEGMENTO_BC_PRE2020, 'SIN HIT') END AS SEGMENTO_BC_PRE2020,
    CASE WHEN SEGMENTO_BC_2020 IS NULL AND FLG_IQ_MATCH = 1 THEN 'NOHIT' ELSE COALESCE(SEGMENTO_BC_2020, 'SIN HIT') END AS SEGMENTO_BC_2020
  FROM APIS_APIA_VAR
),

ACTUALIZA_OTROS_VAL_2 AS (
/* **********************************************************************
*****     ACTUALIZA LOS OTROS VALORES PT2 TMP_APIS_APIA_VAR         *****
********************************************************************** */
  SELECT 
    * EXCEPT(SEGMENTO_BC_2020),
    CASE 
      WHEN SEGMENTO_BC_2020 = 'NOHIT' AND FLG_TL_MATCH = 0 THEN 'NOHIT - SIN TL'
      WHEN SEGMENTO_BC_2020 = 'NOHIT' AND FLG_TL_MATCH = 1 THEN 'NOHIT - CON TL'
      ELSE SEGMENTO_BC_2020 
    END AS SEGMENTO_BC_2020
  FROM ACTUALIZA_OTROS_VAL
),

ACTUALIZA_VAL_SCORECARD AS (
/* **********************************************************************
*****     ACTUALIZA VALORES SCORECARD. TMP_APIS_APIA_VAR            *****
********************************************************************** */
SELECT * EXCEPT(SC_N_VAR_03,SC_N_VAR_04)
      ,CASE WHEN BR_MODULO_SCORE_DES IN('HIT_DILISA_1') 
            THEN 'Hit Dilisa 2008'
            WHEN BR_MODULO_SCORE_DES IN('HIT_DILISA','HIT_DILISA  ') 
            THEN 'Hit Dilisa 2012'
            WHEN BR_MODULO_SCORE_DES IN('HIT_DIL_17', 'HIT_SUB_Emp_', 'HitSubDobles', 'HitSubPuro','HitSubPuro  ','HIT_DIL_17  ',
                                        'Hit_Suburbia', 'SC_CHALLENGER_DILISA', 'SC_CHALLENGER_DILISA_EMPLEADO','SC_CHALLENGER_SUBURBIA',
                                        'SC_CHALLENGER_SUBURBIA_EMPLEADO') 
            THEN 'Hit Dilisa 2017'
            WHEN BR_MODULO_SCORE_DES IN ('HIT_LPC_DIL_', 'HIT_LPC_PUR_', 'HIT_LPC', 'SC_LPC_HIT_DOBLES_PUROS_EMPLEADOS',
                                         'SC_LPC_HIT_DOBLES_Y_PUROS', 'SC_VISA_SUBURBIA') 
            THEN 'Hit LPC 2016'
            WHEN BR_MODULO_SCORE_DES IN('NO_HIT') 
            THEN 'No Hit 2012'
            WHEN BR_MODULO_SCORE_DES IN ('NO_HIT_LPC_1', 'SC_NOHIT_LPC', 'SC_NOHIT_LPC_EMPLEADO', 'NOHIT_Suburb',
                                         'NO_DILISA_16', 'NoHitSubVisa', 'NoHitSuburbi', 'SC_NOHITSUBURBIA', 'SC_NOHIT_DILISA',
                                         'SC_NOHIT_DILISA_EMPLEADO', 'SC_SUBURBIAVISA_NOHIT') 
            THEN 'No Hit 2016'
            WHEN BR_MODULO_SCORE_DES IN ('SC_SUBURBIATHINFILE', 'SC_THINFILE', 'SC_THINFILE_LPC', 
                                         'SC_THINFILE_SUBURBIAVISA', 'TFSuburbia', 'TF_DILISA_16') 
            THEN 'Thin File 2016'
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD1_THINREV_SIM','SCORECARD1_THINREV_SIM_SBB') 
            THEN 'Hit Dilisa 2020'
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD2_THICKREVAGELT30_SIM','SCORECARD2_THICKREVAGELT30_SIM_SBB') 
            THEN 'Hit Dilisa 2020'
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD3_THICKREVAGEGE30_SIM','SCORECARD3_THICKREVAGEGE30_SIM_SBB') 
            THEN 'Hit Dilisa 2020'
            WHEN BR_MODULO_SCORE_DES = 'SCORECARD_LPCPUROS2020' AND BR_ORG = 100 AND (SegmentoScore = 4 OR BR_CTE_LIV <= 0 OR BR_CTE_LIV IS NULL)
            THEN 'LPC Puros 2020'
            WHEN BR_MODULO_SCORE_DES = 'SCORECARD_LPCPUROS2020' AND BR_ORG = 100 AND (SegmentoScore = 12 OR BR_CTE_LIV > 0)
            THEN 'LPC Dobles 2020'
            WHEN BR_MODULO_SCORE_DES = 'SCORECARD_LPCPUROS2020' AND BR_ORG = 200 AND (SegmentoScore IN (11,13) OR BR_CTE_LIV <= 0 OR BR_CTE_LIV IS NULL)
            THEN 'VISA Puros 2020'
            WHEN BR_MODULO_SCORE_DES = 'SCORECARD_LPCPUROS2020' AND BR_ORG = 200 AND (SegmentoScore IN (10,16) OR BR_CTE_LIV > 0)
            THEN 'VISA Dobles 2020'
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_NOHITDILISA_CONTL_2020','SCORECARD_NOHITDILISA_CONTL_2020SEL') 
            THEN 'No Hit Dilisa 2020'
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_NOHITDILISA_SINTL_2020','SCORECARD_NOHITDILISA_SINTL_2020SEL') 
            THEN 'No Hit Dilisa 2020'
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_SUBURBIANOHIT_SINTL_2021','SCORECARD_SUBURBIANOHIT_SINTL_2021SEL') 
            THEN 'No Hit SBB TD 2020'
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_SUBURBIANOHIT_CONTL_2021','SCORECARD_SUBURBIANOHIT_CONTL_2021SEL') 
            THEN 'No Hit SBB TD 2020'
            ELSE REPLACE(BR_MODULO_SCORE_DES,'SCORECARD','') END AS SCORECARD  
      ,CASE WHEN BR_MODULO_SCORE_DES IN ('SCORECARD1_THINREV_SIM','SCORECARD1_THINREV_SIM_SBB') 
            THEN 'S1 ThinRev'
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD2_THICKREVAGELT30_SIM','SCORECARD2_THICKREVAGELT30_SIM_SBB')  
            THEN 'S2 ThickRevAgeLT30'
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD3_THICKREVAGEGE30_SIM','SCORECARD3_THICKREVAGEGE30_SIM_SBB') 
            THEN 'S3 ThickRevAgeGE30'
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_NOHITDILISA_CONTL_2020','SCORECARD_NOHITDILISA_CONTL_2020SEL',
                                           'SCORECARD_SUBURBIANOHIT_CONTL_2021','SCORECARD_SUBURBIANOHIT_CONTL_2021SEL')
            THEN 'Con TL'
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_NOHITDILISA_SINTL_2020','SCORECARD_NOHITDILISA_SINTL_2020SEL',
                                           'SCORECARD_SUBURBIANOHIT_SINTL_2021','SCORECARD_SUBURBIANOHIT_SINTL_2021SEL')
            THEN 'Sin TL'
            END AS SEGMENTO_SCORE
      ,CASE WHEN BR_MODULO_SCORE_DES = 'SCORECARD_LPCPUROS2020' 
            THEN BR_EDC_CVE
            WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_NOHITDILISA_CONTL_2020','SCORECARD_NOHITDILISA_CONTL_2020SEL',
                                           'SCORECARD_SUBURBIANOHIT_CONTL_2021','SCORECARD_SUBURBIANOHIT_CONTL_2021SEL',
                                           'SCORECARD_NOHITDILISA_SINTL_2020','SCORECARD_NOHITDILISA_SINTL_2020SEL',
                                           'SCORECARD_SUBURBIANOHIT_SINTL_2021','SCORECARD_SUBURBIANOHIT_SINTL_2021SEL',
                                           'SCORECARDSBBNOHITNREV_AGEGE30','SCORECARDSBBNOHITNREV_AGELT30','SCORECARDSBBNOHIT_CLSDREVTL') 
            THEN BR_ESCOLARIDAD
            ELSE SC_N_VAR_03 END AS SC_N_VAR_03
      ,CASE WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_LPCPUROS2020',
                                           'SCORECARD_NOHITDILISA_CONTL_2020','SCORECARD_NOHITDILISA_CONTL_2020SEL',
                                           'SCORECARD_NOHITDILISA_SINTL_2020','SCORECARD_NOHITDILISA_SINTL_2020SEL',
                                           'SCORECARD_SUBURBIANOHIT_SINTL_2021','SCORECARD_SUBURBIANOHIT_SINTL_2021SEL')
            THEN BR_SEXO
            END AS SC_V_VAR_01
      ,CASE WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_NOHITDILISA_SINTL_2020','SCORECARD_NOHITDILISA_SINTL_2020SEL',
                                           'SCORECARD_SUBURBIANOHIT_SINTL_2021','SCORECARD_SUBURBIANOHIT_SINTL_2021SEL') 
            THEN BR_ANT_DOM_ANIOS
            ELSE SC_N_VAR_04 END AS SC_N_VAR_04
    FROM ACTUALIZA_OTROS_VAL_2
),

