APIS_APIA_VAR AS (
  -- Genera tabla APIS APIA VAR TMP_APIS_APIA_VAR
  SELECT 
    * EXCEPT(TDA_CVE, FOLIO, BR_FOLIO, REGION, BR_CTE_LIV, BR_SOLIC_CVE, FLG_TEST_CASE),TDA_CVE AS BR_TDA_CVE,
    REGION AS ZONA,
    CASE 
      WHEN TYPE = 210 AND LOG_CVE = 210 AND BR_ORG = 110 AND DT_FCH_SOL >= '2021-10-26' AND CTA_CVE NOT IN (23101000000041,23101000000090) THEN 'Dilisa Garantizada'
      WHEN BR_ORG = 100 AND TYPE NOT IN (749,851) AND TDA_CVE = 99 AND SYS_FTE = 75 AND BR_IMP_LIM_CRED > 100000 AND DT_FCH_SOL >= '2023-05-01' THEN 'BYD'
      WHEN BR_ORG = 210 AND BR_TIPO = 81 AND DT_FCH_SOL >= '2020-10-19' AND DT_FCH_SOL < '2022-02-01' THEN 'Minipagos'
      WHEN BR_ORG = 210 THEN 'SBB Depatamental'
      WHEN BR_ORG = 200 THEN 'SBB VISA'
      WHEN BR_ORG = 110 THEN 'Dilisa'
      WHEN BR_ORG = 100 AND BR_TIPO = 7500 THEN 'Just Me' 
      WHEN BR_ORG = 100 THEN 'LPC' 
      WHEN BR_ORG = 230 THEN 'Minipagos'
    END AS PRODUCTO,
    CASE WHEN TYPE = 210 AND LOG_CVE = 210 AND BR_ORG = 110 AND DT_FCH_SOL >= '2021-10-26' THEN GREATEST(BR_IMP_LIM_CRED,CTA_LAST_LIM_CRE) ELSE 0 END AS LINEA_GARANTIZADA,
    CASE 
      WHEN BR_ORG = 200 AND DT_FCH_SOL < '2021-03-01' AND TL_CTA_SBB_TD > 0 THEN 1
      WHEN BR_ORG = 200 AND DT_FCH_SOL >= '2023-03-01' AND SegmentoScore IN (10,16) THEN 1 
      WHEN BR_ORG = 100 AND SegmentoScore IN (12) THEN 1
      ELSE BR_CTE_LIV 
    END AS BR_CTE_LIV,
    CASE 
      WHEN BR_TIPO = 81 AND (DT_FCH_SOL < '2020-10-19' OR DT_FCH_SOL >= '2022-02-01') THEN 1
      WHEN BR_TIPO IN (81, 91) THEN 1 
      ELSE FLG_TEST_CASE 
    END AS FLG_TEST_CASE,
