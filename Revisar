DICTAMEN_3 AS( 
SELECT * EXCEPT(BR_STT_CRED_DES),
      --EXCEPT(BR_STT_CRED_DES, BR_DICTAMEN_DES),
       CASE WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND BR_MSJ_DES = 'DECLINADO POR FRAUDE' THEN 'DECLINE'
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND BR_MSJ_DES = 'DECLINADO POR NO AUTENTICADO' THEN 'DECLINE'
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND BR_MSJ_DES = 'DECLINADO POR VERIFICACION DOCUMENTAL' THEN 'DECLINE'
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND STT_LEXIS IN ("REJECT","REVIEW") THEN "DECLINE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "DECLINADA POR NO AUTENTICAR" THEN "DECLINE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "ERROR SISTEMA" THEN "DECLINE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "ESTA SOLICITUD NO FUÉ ORIGINADA POR GAPSI." THEN "DECLINE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "ESTA SOLICITUD YA FUÉ PROCESADA POR GAPSI." THEN "DECLINE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "RESPUESTA DETERMINADA POR LEXIS NEXIS" AND STT_BR = "LNP" THEN "NO DECISION"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "SOLICITUD APROBADA FALTA DIGITALIZAR" THEN "NO DECISION"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "SOLICITUD APROBADA FALTAN SEGUNDOS DATOS" THEN "NO DECISION"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "SOLICITUD APROBADA FALTAN SEGUNDOS DATOS NO HIT" THEN "NO DECISION"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO LIKE "%DECLINADA%" THEN "DECLINE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "SOLICITUD EN INVESTIGACIÓN" THEN "NO DECISION"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "SOLICITUD NO AUTENTICADA" THEN "DECLINE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "TARJETA ENTREGADA SOLICITUD FINALIZADA" THEN "APPROVE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO LIKE '%YA EXISTE EN APM%' THEN "DECLINE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_STT_FICO = "SE TERMINO LA SOLICITUD PORQUE NO TUVO MOVIMIENTOS EN 30 DIAS" THEN "DECLINE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND EDO_PTA IN ("DA1","DA2","DP1","DP2","V2DP1") THEN "NO DECISION"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND DES_WS_FICO IN ("APM_UploadDocument_Fail","OMAPM_UNKNOWN_ERROR","APM_Notification_Error") THEN "DECLINE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND STT_BR = "5" THEN "DECLINE"
            WHEN (BR_STT_CRED_DES IS NULL OR BR_STT_CRED_DES IN ("NO DECISION", "INVESTIGATE")) AND BR_MSJ_DES = "NO AUTENTICADO" THEN "DECLINE"
            ELSE COALESCE(BR_STT_CRED_DES,"NO DECISION") END AS BR_STT_CRED_DES,
FROM DICTAMEN_2
),

