DICTAMEN_2 AS (
    SELECT * EXCEPT(BR_DICTAMEN_DES, DICTAMEN),
        CASE WHEN ST_APROB=0 AND CAUSA_RECHAZO = "VERIFICACIÓN DOCUMENTAL" THEN "PROCESO DICTAMINACIÓN"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = "VERIFICACIÓN TELEFÓNICA" THEN "PROCESO DICTAMINACIÓN"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = "SOLICITUD DE TIENDA" THEN "PROCESO DICTAMINACIÓN"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = "SOLICITUD INVESTIGACION" THEN "PROCESO DICTAMINACIÓN"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = "INACTIVIDAD" THEN "TRÁMITE INCONCLUSO"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = "NO AUTENTICADO" THEN "ERROR"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = "ERROR SISTEMA" THEN "ERROR"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = "RESPUESTA DETERMINADA POR LEXIS NEXIS" THEN "REGLAS DE FRAUDE"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = "REVISION LEXIS" THEN "REGLAS DE FRAUDE"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = "FALTA DIGITALIZAR" THEN "TRÁMITE INCONCLUSO"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = "FALTA SEGUNDOS DATOS" THEN "TRÁMITE INCONCLUSO"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = "FALTA INFORMACION DEL USUARIO PARA CONSULTA"THEN "TRÁMITE INCONCLUSO"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = 'SCORE INSUFICIENTE' THEN 'SCORE'
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = 'ESTRATEGIA NO VÁLIDA NO HIT VISA' THEN 'REQUERIMIENTOS MÍNIMOS'
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = 'DOBLE CAPTURA' THEN 'DUPLICADOS'
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = 'CUENTA NUEVA MENOR A 6 MESES' THEN 'REQUERIMIENTOS MÍNIMOS'
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = 'CUENTA NUEVA MENOR A 3 MESES' THEN 'REQUERIMIENTOS MÍNIMOS'
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = 'CUENTA CON ATRASO +90 DÍAS' THEN 'HISTORIAL CREDITICIO SOCIEDADES DE INFORMACIÓN (OFF-US)'
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = 'CUENTA CON ATRASO +60 DÍAS' THEN 'HISTORIAL CREDITICIO SOCIEDADES DE INFORMACIÓN (OFF-US)'
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = 'CUENTA CANCELADA MENOR A 18 MESES' THEN 'REQUERIMIENTOS MÍNIMOS'
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = 'DOWNSELL RECHAZADO POR EL CLIENTE' THEN "PROCESO DICTAMINACIÓN"
             WHEN ST_APROB=0 AND CAUSA_RECHAZO = 'REGLAS DE FRAUDE' THEN 'REGLAS DE FRAUDE'
             WHEN ST_APROB=0 THEN DICTAMEN ELSE NULL END AS BR_DICTAMEN_DES
    FROM RECHAZO3
