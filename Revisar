CARDS_APPLY AS (
SELECT
  a.* EXCEPT(TDA_CVE,BR_CANAL_SEL),
  CASE
    WHEN a.BR_ORG IN (100,110) AND SYS_FTE='ORI_SEL' THEN COALESCE(SAFE_CAST(b.TDA_CVE AS NUMERIC),39)
    WHEN a.BR_ORG IN (200,210,230) AND SYS_FTE='ORI_SEL' THEN COALESCE(c.TDA_CVE,782)
    ELSE a.TDA_CVE END AS TDA_CVE,
  CASE
    WHEN a.BR_ORG IN (100,110) AND SYS_FTE='ORI_SEL' AND b.TDA_CVE IS NOT NULL THEN 'CREDIPOCKET'
    WHEN a.BR_ORG IN (200,210,230) AND SYS_FTE='ORI_SEL' AND b.TDA_CVE IS NOT NULL THEN 'CREDIPOCKET'
    WHEN SYS_FTE='ORI_SEL' THEN 'SEL'
    WHEN SD_ID_VAL IS NOT NULL THEN "OD_TABLET"
    WHEN SD_ID_VAL IS NULL THEN "OD_MODULO"
  END AS BR_CANAL_SEL
FROM(
  SELECT 
    a.ID_MC AS FOLIO,
    SAFE_CAST(a.BR_SOLIC_CVE AS NUMERIC) AS BR_SOLIC_CVE,
    FCH_LEXIS,
    STT_LEXIS,
    STT_BR,
    DES_STT_FICO,
    a.PROD AS PRODUCTO,
    a.CL AS BR_CANAL_SEL,
    FLAG_LEXIS,
    FLAG_FICO,
    a.EDO_PTA,
    a.SD_ID_VAL,
    DES_WS_FICO,
    SAFE_CAST(TDA AS NUMERIC) AS TDA_CVE,
    a.SYS_FTE,
    a.FCH_CAP,
    CAST(a.FCH_CAP AS DATE) DT_FCH_SOL,
    FORMAT_DATE("%Y%m", CAST(a.FCH_CAP AS DATE)) DT_FEC_SOL,
    CASE
      WHEN a.TIP_INF IS NULL AND a.PROD='JUST ME' THEN 100
      WHEN a.TIP_INF IS NULL AND a.PROD='LIVERPOOL' THEN 110
      WHEN a.TIP_INF IS NULL AND a.PROD='LIVERPOOL VISA' THEN 100
      WHEN a.TIP_INF IS NULL AND a.PROD='SUBURBIA DEPARTAMENTAL - CLIENTE' THEN 210
      WHEN a.TIP_INF IS NULL AND a.PROD='SUBURBIA' THEN 210
      WHEN a.TIP_INF IS NULL AND a.PROD='SUBURBIA VISA' THEN 200
      WHEN a.TIP_INF IS NULL AND a.PROD='TARJETA MINIPAGOS' THEN 230   
      WHEN a.TIP_INF IS NULL AND a.PROD='SUBURBIA TARJETA MINIPAGOS' THEN 230    
      ELSE a.TIP_INF
    END AS BR_ORG,
    CASE
      WHEN TIP_INF=100 AND BR_TIPO=100 THEN 8490
      WHEN TIP_INF=100 AND BR_TIPO=120 THEN 7500
      WHEN TIP_INF=100 AND BR_TIPO=500 THEN 8510
      WHEN TIP_INF=100 AND BR_TIPO=700 THEN 7490
      WHEN TIP_INF=110 AND BR_TIPO=100 THEN 1000
      WHEN TIP_INF=110 AND BR_TIPO=200 THEN 2000
      WHEN TIP_INF=110 AND BR_TIPO=300 THEN 3000
      WHEN TIP_INF=110 AND BR_TIPO=500 THEN 5000
      WHEN TIP_INF=200 AND BR_TIPO=100 THEN 1030
      WHEN TIP_INF=210 AND BR_TIPO=100 THEN 1010
      WHEN TIP_INF=210 AND BR_TIPO=600 THEN 1020
      WHEN TIP_INF=220 AND BR_TIPO=200 THEN 2000
      WHEN TIP_INF=230 AND BR_TIPO=100 THEN 1000
      WHEN a.PROD='JUST ME' THEN 7500
      WHEN a.PROD='LIVERPOOL' THEN 5000
      WHEN a.PROD='LIVERPOOL VISA' THEN 1000
      WHEN a.PROD='SUBURBIA DEPARTAMENTAL - CLIENTE' THEN 1010
      WHEN a.PROD='SUBURBIA' THEN 1010
      WHEN a.PROD='SUBURBIA VISA' THEN 1030
      WHEN a.PROD='TARJETA MINIPAGOS' THEN 1000   
      WHEN a.PROD='SUBURBIA TARJETA MINIPAGOS' THEN 1000   
    END AS BR_TIPO,
    CASE 
      WHEN a.CL='ORIGINACION DIGITAL LIVERPOOL' THEN 8
      WHEN a.CL='ORIGINACION DIGITAL SUBURBIA' THEN 9
      WHEN a.CL='APLICACION IOS LIVERPOOL' THEN 11
      WHEN a.CL='APLICACION ANDROID LIVERPOOL' THEN 10
      WHEN a.CL='APLICACION IOS SUBURBIA' THEN 13
      WHEN a.CL='APLICACION ANDROID SUBURBIA' THEN 12
    END AS BR_CANAL_CVE,
    SAFE_CAST(a.NUM_EMP AS NUMERIC) AS NUM_EMP
    FROM crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VFAC_PREVFRAU_CARDS_APPLY_ONLINE_MC2 a
    LEFT JOIN crp-pro-dwh-semanticagold.EIL_DP_VMASTER.VFAC_PREVFRAU_SOLICITUDENLINEA b
    ON a.ID_MC = b.ID_MC
    WHERE a.FCH_CAP >= DATE_ADD(DATE_TRUNC(CURRENT_DATE('America/Mexico_City'), YEAR),INTERVAL -5 YEAR)
    ) a 
    LEFT JOIN crp-pro-dwh-semanticagold.EIL_DP_VDWH.VDIM_VND b
    ON a.NUM_EMP=b.VND_CVE
    LEFT JOIN crp-pro-dwh-semanticagold.MUS_PRO_DWH_SAS_TEMP.PlantillaSBB_FEB26 c
    ON a.NUM_EMP=c.NUM_EMP
),

