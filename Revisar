INFO_CTA2 AS (
-- Obtener la infomracion de la cuenta TMP_APIS_APIA_CTA
  SELECT 
    a.* EXCEPT(LOG_CVE),
    c.DT_FCH_ALTA, c.DT_FEC_ALTA, c.CTE_CVE_UNICO, c.FLG_TIT, c.FLG_PIF, c.DT_FCH_ULT_CMP,
    c.CTA_EDO_CVE, c.CCR_CVE_BLQ_UNO, c.CCR_CVE_BLQ_DOS, SAFE_CAST(c.CTA_FCH_PRM_CMP AS DATE) AS DT_FCH_PRM_CMP,
    CASE WHEN (a.CTA_CVE_APIS = c.CTA_CVE OR c.CTA_CVE IS NULL OR c.CTA_CVE = 0) THEN a.CTA_CVE_APIS ELSE c.CTA_CVE END AS CTA_CVE,
    c.CTA_IMP_LIM_CRD AS BR_IMP_LIM_CRED,
    COALESCE(c.LOG_CVE, a.LOG_CVE) AS LOG_CVE, 
    CTA_LAST_LIM_CRE,
  FROM TMP_BURO a
  LEFT JOIN CTA_ALTA c
  ON(a.CTA_CVE_APIS = c.CTA_CVE)
  WHERE a.CTA_CVE_APIS > 0
  UNION ALL 
  SELECT 
    a.* EXCEPT(LOG_CVE),
    c.DT_FCH_ALTA, c.DT_FEC_ALTA, c.CTE_CVE_UNICO, c.FLG_TIT, c.FLG_PIF, c.DT_FCH_ULT_CMP,
    c.CTA_EDO_CVE, c.CCR_CVE_BLQ_UNO, c.CCR_CVE_BLQ_DOS, SAFE_CAST(c.CTA_FCH_PRM_CMP AS DATE) AS DT_FCH_PRM_CMP,
    CASE WHEN (a.CTA_CVE_APIS = c.CTA_CVE OR c.CTA_CVE IS NULL OR c.CTA_CVE = 0) THEN a.CTA_CVE_APIS ELSE c.CTA_CVE END AS CTA_CVE,
    c.CTA_IMP_LIM_CRD AS BR_IMP_LIM_CRED,
    COALESCE(c.LOG_CVE, a.LOG_CVE) AS LOG_CVE, CTA_LAST_LIM_CRE,
  FROM TMP_BURO a
  LEFT JOIN CTA_ALTA c
  ON(a.BR_SOLIC_CVE = c.BR_SOLIC_CVE AND a.TYPE = c.BR_TIPO)
  WHERE a.CTA_CVE_APIS IS NULL OR CTA_CVE_APIS = 0
),

