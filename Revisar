    WHEN BR_ORG = 100 AND FLG_TL_MATCH=1 AND TL_CTA_DILISA <= 0 AND TL_CTA_LPC <= 0 AND TL_NUM_CTAS_TDC_ABT=1 
    THEN '04. 1 OffUs'
    WHEN BR_ORG = 100 AND FLG_TL_MATCH=1 AND TL_CTA_DILISA > 0 AND TL_CTA_LPC > 0
    THEN '05. Dilisa + LPC'
    WHEN BR_ORG = 100 AND FLG_TL_MATCH=1 AND TL_CTA_DILISA > 0 AND TL_CTA_LPC <= 0 AND TL_NUM_CTAS_TDC_ABT=1 
    THEN '06. Dilisa + 1 OffUs'
    WHEN BR_ORG = 100 AND FLG_TL_MATCH=1 AND TL_CTA_LPC > 0 AND TL_CTA_DILISA <= 0 AND TL_NUM_CTAS_TDC_ABT=1 
    THEN '07. LPC + 1 OffUs'
    WHEN BR_ORG = 100 AND FLG_TL_MATCH=1 AND TL_CTA_DILISA <= 0 AND TL_CTA_LPC <= 0 AND TL_NUM_CTAS_TDC_ABT=2 
    THEN '08. 2 OffUs'
    WHEN BR_ORG = 100 AND FLG_TL_MATCH=1 AND TL_CTA_DILISA > 0 AND TL_CTA_LPC <= 0 AND TL_NUM_CTAS_TDC_ABT >= 2 
    THEN '09. Dilisa + 2+ OffUs'
    WHEN BR_ORG = 100 AND FLG_TL_MATCH=1 AND TL_CTA_LPC > 0 AND TL_CTA_DILISA <= 0 AND TL_NUM_CTAS_TDC_ABT >= 2 
    THEN '10. LPC + 2+ OffUs'
    WHEN BR_ORG = 100 AND FLG_TL_MATCH=1 AND TL_CTA_DILISA <= 0 AND TL_CTA_LPC <= 0 AND TL_NUM_CTAS_TDC_ABT >= 3 
    THEN '11. 3+ OffUs'
    WHEN BR_ORG = 100 
    THEN '0. No identificado'

    WHEN ST_OTORG=1 AND BR_ORG = 210 AND BR_HIT_DES='X-SELL' THEN '08. No consultado'
    WHEN ST_OTORG=1 AND BR_ORG = 210 AND (FLG_TL_MATCH<=0 OR (TL_CTA_SBB_VISA <= 0 AND TL_NUM_CTAS_TDC_ABT <=0)) THEN '01. TD Puro'
    WHEN ST_OTORG=1 AND BR_ORG = 210 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_VISA > 0 THEN '02. TD + VISA'
    WHEN ST_OTORG=1 AND BR_ORG = 210 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_VISA <= 0 AND TL_NUM_CTAS_TDC_ABT=1 THEN '03. TD + 1 OffUs'
    WHEN ST_OTORG=1 AND BR_ORG = 210 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_VISA > 0 AND TL_NUM_CTAS_TDC_ABT=1 THEN '04. TD + VISA + 1 OffUs'
    WHEN ST_OTORG=1 AND BR_ORG = 210 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_VISA <= 0 AND TL_NUM_CTAS_TDC_ABT=2 THEN '05. TD + 2 OffUs'
    WHEN ST_OTORG=1 AND BR_ORG = 210 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_VISA > 0 AND TL_NUM_CTAS_TDC_ABT >= 2 THEN '06. TD + VISA + 2+ OffUs'
    WHEN ST_OTORG=1 AND BR_ORG = 210 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_VISA <= 0 AND TL_NUM_CTAS_TDC_ABT >= 3 THEN '07. TD + 3+ OffUs'
    WHEN ST_OTORG=1 AND BR_ORG = 210 THEN '0. No identificado'
    
    WHEN ST_OTORG=1 AND BR_ORG = 200 AND BR_HIT_DES='X-SELL' THEN '08. No consultado'
    WHEN ST_OTORG=1 AND BR_ORG = 200 AND (FLG_TL_MATCH<=0 OR (TL_CTA_SBB_TD<=0 AND TL_NUM_CTAS_TDC_ABT <=0)) THEN '01. VISA Puro'
    WHEN ST_OTORG=1 AND BR_ORG = 200 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_TD>0 THEN '02. TD + VISA'
    WHEN ST_OTORG=1 AND BR_ORG = 200 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_TD<=0 AND TL_NUM_CTAS_TDC_ABT=1 THEN '03. VISA + 1 OffUs'
    WHEN ST_OTORG=1 AND BR_ORG = 200 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_TD>0 AND TL_NUM_CTAS_TDC_ABT=1 THEN '04. TD + VISA + 1 OffUs'
    WHEN ST_OTORG=1 AND BR_ORG = 200 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_TD<=0 AND TL_NUM_CTAS_TDC_ABT=2 THEN '05. VISA + 2 OffUs'
    WHEN ST_OTORG=1 AND BR_ORG = 200 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_TD>0 AND TL_NUM_CTAS_TDC_ABT>=2 THEN '06. TD + VISA + 2+ OffUs'
    WHEN ST_OTORG=1 AND BR_ORG = 200 AND FLG_TL_MATCH=1 AND TL_CTA_SBB_TD<=0 AND TL_NUM_CTAS_TDC_ABT>=3 THEN '07. VISA + 3+ OffUs'
    WHEN ST_OTORG=1 AND BR_ORG = 200 THEN '0. No identificado'
        END AS SEGMENTO_CLIENTE
    FROM ESTATUS_SOL
),

ENDEUDAMIENTO AS (
/* **********************************************************************
*****     ENDEUDAMIENTO. TMP_APIS_APIA_VAR                          *****
********************************************************************** */
    SELECT * EXCEPT(ST_APROB), --- cambio no solicitado   
        -- Revolvente
        CASE WHEN FLG_TL_MATCH=1 AND TL_NUM_CTAS_TDC_ABT>0 AND BR_ING_TOT>0
            THEN TL_SUM_LIM_CRED_CTAS_TDC_ABT/BR_ING_TOT
            ELSE NULL END AS LTI_REV, 
        CASE WHEN FLG_TL_MATCH=1 AND TL_NUM_CTAS_TDC_ABT>0 AND BR_ING_TOT>0
            THEN TL_SUM_PAG_CTAS_TDC_ABT/BR_ING_TOT
            ELSE NULL END AS PTI_REV, 
        -- Total
        CASE WHEN FLG_TL_MATCH=1 AND TL_NUM_CTAS_ABT>0 AND BR_ING_TOT>0
            THEN TL_SUM_IMP_PAG_ABT/BR_ING_TOT
            ELSE NULL END AS PTI,
        -- Revolvente 
        CASE WHEN FLG_TL_MATCH=1 AND TL_NUM_CTAS_TDC_ABT>0 AND BR_ING_TOT>0
            THEN TL_SUM_SDO_CTAS_TDC_ABT/BR_ING_TOT
            ELSE NULL END AS BTI_REV,
        CASE WHEN FLG_TL_MATCH=1 AND (TL_NUM_CTAS_NOM_ABT + TL_NUM_CTAS_PERS_ABT + TL_NUM_CTAS_TDC_ABT)>0 AND BR_ING_TOT>0
            THEN (TL_SUM_SDO_CTAS_NOM_ABT + TL_SUM_SDO_CTAS_PERS_ABT + TL_SUM_SDO_CTAS_TDC_ABT) / BR_ING_TOT
        END BTI  
        ,CASE WHEN DES_STT_FICO = "TARJETA ENTREGADA SOLICITUD FINALIZADA" THEN 1 ELSE ST_APROB END AS ST_APROB --- NUEVA REGLA DE CALCULO NO CONSIDERADA CAML 08/01/2025    
    FROM SEG_CTE
),

RECHAZO AS (
/* **********************************************************************
*****     CAUSAS DE RECHAZO. TMP_APIS_APIA_VAR                      *****
********************************************************************** */
-- Cambiar
    SELECT a.*
          ,CASE WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND a.BR_MSJ_DES = 'DECLINADO POR FRAUDE'            THEN 'REGLAS DE FRAUDE' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND a.BR_MSJ_DES = 'DECLINADO POR NO AUTENTICADO'            THEN 'NO AUTENTICADO' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND a.BR_MSJ_DES = 'DECLINADO POR VERIFICACION DOCUMENTAL'           THEN 'VERIFICACION DOCUMENTAL' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.STT_LEXIS) IN ("REJECT", "REVIEW")               THEN "LEXIS NEXIS"
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.STT_BR) IN ("LND", "LNR")                        THEN "LEXIS NEXIS"
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_WS_FICO) LIKE "%ERROR%"                      THEN 'ERROR SISTEMA' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_WS_FICO) LIKE "%FAIL%"                       THEN 'ERROR SISTEMA'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_WS_FICO) LIKE "%APM_OMDMBUREAUINTEGRADO_NO%"         THEN 'FALTAN SEGUNDOS DATOS NO HIT'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_WS_FICO) LIKE "%APM_ACCCREATIONCOMPLETE%"            THEN 'FALTA DIGITALIZAR'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_WS_FICO) LIKE "%APM_PENDINGINTERNETAPP%"             THEN 'FALTAN SEGUNDOS DATOS'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%YA EXISTE EN APM%"          THEN 'FOLIO MC ASOCIADO A OTRA SOLICITUD' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%NO AUTENTICA%"              THEN 'NO AUTENTICADO' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%SEGUNDOS DATOS NO HIT%"             THEN 'FALTAN SEGUNDOS DATOS NO HIT'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%SEGUNDOS DATOS%"            THEN 'FALTAN SEGUNDOS DATOS'                
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%NO TUVO MOVIMIENTOS%"       THEN 'INACTIVIDAD'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%FALTA DIGITALIZAR%"         THEN 'FALTA DIGITALIZAR'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%GAPSI%"                     THEN 'SOLICITUD DE TIENDA'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND BR_STT_CRED_DES = 'INVESTIGATE' AND BR_FLUJO_DES = 'DF_NOHIT_THINFILE' AND BR_STATUS='D' THEN 'VERIFICACION DOCUMENTAL'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND BR_STT_CRED_DES = 'INVESTIGATE' AND BR_FLUJO_DES = 'DF_HAWK'           AND BR_STATUS='D' THEN 'ALERTA HAWK'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND BR_STT_CRED_DES = 'INVESTIGATE' AND BR_FLUJO_DES = 'DF_NOHIT_THINFILE'   THEN 'VERIFICACION DOCUMENTAL'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND BR_STT_CRED_DES = 'INVESTIGATE' AND BR_FLUJO_DES = 'DF_HAWK'             THEN 'ALERTA HAWK'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND BR_STT_CRED_DES = 'INVESTIGATE' AND BR_FLUJO_DES = 'DF_POSTBUREAU' AND BR_STATUS='P' THEN 'CONSULTA BC SCORE'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.STT_BR) IN ("LNE", "LNO")                        THEN "ERROR LEXIS"
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND REPLACE(UPPER(a.DES_STT_FICO),'Á','A') LIKE "%INVALIDO%"         THEN 'ERROR LEXIS'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND REPLACE(REPLACE(REPLACE(UPPER(a.DES_STT_FICO),'Á','A'),'É','E'),'Ú','U') LIKE "%VACIO%" THEN 'ERROR LEXIS'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND EDO_PTA IN ("DP1","DP2","V2DP1")                         THEN "FALTA INFORMACION DEL USUARIO PARA CONSULTA"
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND EDO_PTA IN ("DA1","DA2")                                 THEN "FALTAN SEGUNDOS DATOS"
                ELSE b.CAUSA_RECHAZO END AS CAUSA_RECHAZO
          ,CASE WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND a.BR_MSJ_DES = 'DECLINADO POR FRAUDE'                    THEN 'REGLAS DE FRAUDE' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND a.BR_MSJ_DES = 'DECLINADO POR NO AUTENTICADO'            THEN 'TRÁMITE INCONCLUSO' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND a.BR_MSJ_DES = 'DECLINADO POR VERIFICACION DOCUMENTAL'           THEN 'PROCESO DICTAMINACIÓN' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.STT_LEXIS) IN ("REJECT", "REVIEW")               THEN "REGLAS DE FRAUDE"
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.STT_BR) IN ("LND", "LNR")                        THEN "REGLAS DE FRAUDE"
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_WS_FICO) LIKE "%ERROR%"                      THEN 'ERROR' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_WS_FICO) LIKE "%FAIL%"                       THEN 'ERROR'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_WS_FICO) LIKE "%APM_OMDMBUREAUINTEGRADO_NO%"         THEN 'TRÁMITE INCONCLUSO'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_WS_FICO) LIKE "%APM_ACCCREATIONCOMPLETE%"            THEN 'TRÁMITE INCONCLUSO'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_WS_FICO) LIKE "%APM_PENDINGINTERNETAPP%"             THEN 'TRÁMITE INCONCLUSO'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%YA EXISTE EN APM%"          THEN 'DUPLICADOS' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%NO AUTENTICA%"              THEN 'TRÁMITE INCONCLUSO' 
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%SEGUNDOS DATOS NO HIT%"             THEN 'TRÁMITE INCONCLUSO'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%SEGUNDOS DATOS%"            THEN 'TRÁMITE INCONCLUSO'                
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%NO TUVO MOVIMIENTOS%"       THEN 'TRÁMITE INCONCLUSO'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%FALTA DIGITALIZAR%"         THEN 'TRÁMITE INCONCLUSO'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.DES_STT_FICO) LIKE "%GAPSI%"                     THEN 'PROCESO DICTAMINACIÓN'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND BR_STT_CRED_DES = 'INVESTIGATE' AND BR_FLUJO_DES = 'DF_NOHIT_THINFILE' AND BR_STATUS='D' THEN 'PROCESO DICTAMINACIÓNL'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND BR_STT_CRED_DES = 'INVESTIGATE' AND BR_FLUJO_DES = 'DF_HAWK'           AND BR_STATUS='D' THEN 'REGLAS DE FRAUDE'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND BR_STT_CRED_DES = 'INVESTIGATE' AND BR_FLUJO_DES = 'DF_NOHIT_THINFILE'           THEN 'TRÁMITE INCONCLUSO'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND BR_STT_CRED_DES = 'INVESTIGATE' AND BR_FLUJO_DES = 'DF_HAWK'             THEN 'TRÁMITE INCONCLUSO'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND BR_STT_CRED_DES = 'INVESTIGATE' AND BR_FLUJO_DES = 'DF_POSTBUREAU' AND BR_STATUS='P'     THEN 'TRÁMITE INCONCLUSO'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND UPPER(a.STT_BR) IN ("LNE", "LNO")                        THEN "ERROR"
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND REPLACE(UPPER(a.DES_STT_FICO),'Á','A') LIKE "%INVALIDO%"         THEN 'ERROR'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND REPLACE(REPLACE(REPLACE(UPPER(a.DES_STT_FICO),'Á','A'),'É','E'),'Ú','U') LIKE "%VACIO%" THEN 'ERROR'
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND EDO_PTA IN ("DP1","DP2","V2DP1")                         THEN "TRÁMITE INCONCLUSO"
        WHEN (b.CAUSA_RECHAZO IS NULL OR b.CAUSA_RECHAZO IN ('NO DECISION','SIN REGLA')) AND EDO_PTA IN ("DA1","DA2")                                 THEN "TRÁMITE INCONCLUSO"
                ELSE b.BR_DICTAMEN_DES END AS DICTAMEN
    FROM ENDEUDAMIENTO a
    LEFT JOIN crp-pro-dwh-semanticagold.MUS_PRO_DWH_SAS_TEMP.LRC_MASTER_CAUSAS_RECHAZO b
    ON a.BR_REGLA_DES = b.BR_REGLA_DES
),

RECHAZO2 AS (
    SELECT * EXCEPT(CAUSA_RECHAZO)
      ,CASE WHEN ST_APROB=0 AND BR_STT_CRED_DES='DECLINED BY CUSTOMER' THEN 'DOWNSELL RECHAZADO POR EL CLIENTE'
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND BR_REGLA_DES IN ('VERIFICACIÓN TELEFÓNICA','SCORE INSUFICIENTE','ESTRATEGIA NO VÁLIDA NO HIT VISA','DOBLE CAPTURA','CUENTA NUEVA MENOR A 6 MESES','CUENTA NUEVA MENOR A 3 MESES','CUENTA CON ATRASO +90 DÍAS','CUENTA CON ATRASO +60 DÍAS','CUENTA CANCELADA MENOR A 18 MESES')
            THEN BR_REGLA_DES
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND BR_MSJ_DES = "DECLINADO POR VERIFICACION DOCUMENTAL" 
            THEN "VERIFICACIÓN DOCUMENTAL"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND BR_MSJ_DES = 'DECLINADO POR FRAUDE' 
            THEN 'REGLAS DE FRAUDE'
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND BR_MSJ_DES = "DECLINADO POR NO AUTENTICADO" 
            THEN "NO AUTENTICADO"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND STT_LEXIS IN ("REJECT", "REVIEW") 
            THEN "RESPUESTA DETERMINADA POR LEXIS NEXIS"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO LIKE '%YA EXISTE EN APM%' 
            THEN "FOLIO YA ASOCIADO A UNA SOLICITUD"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="DECLINADA POR NO AUTENTICAR" 
            THEN "NO AUTENTICADO"
		    WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="ESTA SOLICITUD NO FUÉ ORIGINADA POR GAPSI." 
            THEN "SOLICITUD DE TIENDA"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="ESTA SOLICITUD YA FUÉ PROCESADA POR GAPSI." 
            THEN "SOLICITUD DE TIENDA"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="SOLICITUD APROBADA FALTA DIGITALIZAR" 
            THEN "FALTA DIGITALIZAR"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="SOLICITUD APROBADA FALTAN SEGUNDOS DATOS" 
            THEN "FALTA SEGUNDOS DATOS"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="SOLICITUD APROBADA FALTAN SEGUNDOS DATOS NO HIT" 
            THEN "FALTA SEGUNDOS DATOS"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="TARJETA ENTREGADA SOLICITUD FINALIZADA" 
            THEN "REVISION LEXIS"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="SE TERMINO LA SOLICITUD PORQUE NO TUVO MOVIMIENTOS EN 30 DIAS" 
            THEN "INACTIVIDAD"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="SE TERMINO LA SOLICITUD PORQUE NO TUVO MOVIMIENTOS EN 20 DIAS" 
            THEN "INACTIVIDAD"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="SE TERMINO LA SOLICITUD PORQUE NO TUVO MOVIMIENTOS EN 5 DIAS" 
            THEN "INACTIVIDAD"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="ERROR SISTEMA" 
            THEN "ERROR SISTEMA"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="RESPUESTA DETERMINADA POR LEXIS NEXIS" AND STT_BR = "LNP" 
            THEN "FALTA INFORMACION DEL USUARIO PARA CONSULTA"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="SOLICITUD EN INVESTIGACIÓN" 
            THEN "SOLICITUD INVESTIGACION"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="SOLICITUD NO AUTENTICADA" 
            THEN "NO AUTENTICADO"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND EDO_PTA IN ("DP1","DP2","V2DP1") 
            THEN "FALTA INFORMACION DEL USUARIO PARA CONSULTA"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND EDO_PTA IN ("DA1","DA2") 
            THEN "FALTA SEGUNDOS DATOS"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_WS_FICO IN ("APM_UploadDocument_Fail"
                                                                                                                            ,"OMAPM_UNKNOWN_ERROR", "APM_Notification_Error")
            THEN "ERROR SISTEMA"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND STT_BR = "5" 
            THEN "NO AUTENTICADO"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND DES_STT_FICO="SOLICITUD DECLINADA" 
            THEN "NO DECISION"
            WHEN ST_APROB=0 AND (CAUSA_RECHAZO IS NULL OR CAUSA_RECHAZO IN ("NO DECISION","SIN REGLA")) AND STT_BR = "0" 
            THEN "NO DECISION"
            ELSE CAUSA_RECHAZO END AS CAUSA_RECHAZO
    FROM RECHAZO
),

RECHAZO3 AS (
