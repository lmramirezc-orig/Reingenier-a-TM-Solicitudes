APIS_APIA_COMPLETA AS (
  SELECT
    * EXCEPT(rn)
  FROM (
  SELECT
    a.BR_SOLIC_CVE,
    a.BR_TIPO,
    a.BR_ORG,
    CASE WHEN a.BR_TIPO=8491 THEN 949 ELSE CAST(SUBSTR(CAST(a.BR_TIPO AS STRING), 1, 3) AS INT64) END AS TYPE,
    CASE WHEN a.BR_SOLIC_CVE IS NULL THEN 0 ELSE 1 END AS FLG_APIA_MATCH,
    CASE WHEN b.BR_SOLIC_CVE IS NULL THEN 0 ELSE 1 END AS FLG_APIS_MATCH,
    a.SYS_FTE,
    a.BR_CONTROL_BURO,
    a.BR_HIT, 
    a.BR_LIM_CRD, 
    a.BR_SCR, 
    a.CTA_CVE AS CTA_CVE_APIS, 
    a.BR_DOWNSELL, 
    a.BR_STATUS,
    a.BR_FLAG_PTO_PER,
    CASE 
      WHEN a.BR_DOWNSELL = 0 THEN "No Aplica DownSell"
      WHEN a.BR_DOWNSELL = 1 THEN "Candidato DownSell"
      WHEN a.BR_DOWNSELL = 2 THEN "Dilisa Oferta DownSell"
      ELSE "No Aplica DownSell" 
    END AS BR_DOWNSELL_DES,
    a.BR_OPER_CAPT,
    PARSE_DATE('%Y%j', SUBSTR(CAST(a.BR_SOLIC_CVE AS STRING), 1, 7)) AS DT_FCH_SOL,
    FORMAT_DATE("%Y%m", DATE(((SELECT PARSE_DATE("%Y%j", SUBSTR(CAST(a.BR_SOLIC_CVE AS STRING), 1, 7)))))) DT_FEC_SOL,
    CASE 
      WHEN BR_HIT = '0' THEN 'THIN FILE'
      WHEN BR_HIT IN('1','YH') THEN 'HIT'
      WHEN BR_HIT IN('2','NH') THEN 'NOHIT'
      ELSE 'SIN HIT' 
    END BR_HIT_DES,
    CASE 
      WHEN BR_STATUS = 'D' AND BR_LIM_CRD = 0 THEN 'DECLINE'
      WHEN BR_STATUS = 'D' AND BR_LIM_CRD > 0 THEN 'DECLINED BY CUSTOMER'
      WHEN BR_STATUS = 'C' THEN 'CANCELED'
      WHEN BR_STATUS IN ('A', 'T') THEN 'APPROVE'
      ELSE 'NO DECISION'
    END BR_STT_CRED_DES,
    b.BR_EDO, 
    b.BR_FOLIO, 
    b.BR_EDO_EMPR, 
    b.BR_FTE_CAP,
    b.BR_GIRO, 
    b.BR_TDA_CAP AS TIENDA, 
    b.BR_IND_PAPER,
    b.BR_PTO_EMP, 
    b.BR_ANT_DOM_ANIOS, 
    b.BR_ANT_EMP_MESES, 
    b.BR_CDP AS CDP,
    b.BR_EDC_CVE, 
    b.BR_EDAD, 
    b.BR_ESCOLARIDAD, 
    b.BR_ING_TOT, 
    b.BR_NUM_DEP,
    b.BR_SEXO, 
    SAFE_CAST(b.BR_TIP_VDA AS INT64) AS BR_TIP_VDA,
    ROW_NUMBER() OVER(PARTITION BY a.BR_SOLIC_CVE, a.BR_TIPO, a.BR_ORG ORDER BY CASE 
                                                                            WHEN a.BR_STATUS='T' THEN 5
                                                                            WHEN a.BR_STATUS='D' THEN 4
                                                                            WHEN a.BR_STATUS='A' THEN 3
                                                                            WHEN a.BR_STATUS='C' THEN 2
                                                                            ELSE 0 END) AS rn

    FROM crp-pro-dwh-semanticagold.EIL_DP_VDWH.VFAC_APIS a
    LEFT JOIN crp-pro-dwh-semanticagold.EIL_DP_VDWH.VFAC_APIA b
    USING(BR_SOLIC_CVE, SYS_FTE)
    WHERE a.FCH_CARGA >= DATE_ADD(DATE_TRUNC(CURRENT_DATE('America/Mexico_City'), YEAR),INTERVAL -5 YEAR)
  ) WHERE rn = 1
),

VFAC_OMDM_FLUJO AS (
  SELECT 
    * EXCEPT(rn)
  FROM (
    SELECT 
      *,
      ROW_NUMBER() OVER (PARTITION BY BR_SOLIC_CVE, BR_TIPO ORDER BY CASE WHEN BR_FLUJO_CVE = 7 THEN 999 ELSE BR_FLUJO_CVE END DESC) as rn,
      CASE WHEN BR_TIPO = 8491 THEN 949 ELSE CAST(SUBSTR(CAST(BR_TIPO AS STRING), 1, 3) AS INT64) END AS TYPE,
      CASE 
        WHEN BR_FLUJO_CVE IN(1, 7) AND BR_STT_CRED_CVE = 1 THEN 5
        WHEN BR_FLUJO_CVE = 3 AND BR_STT_CRED_CVE = 2 THEN 3
        WHEN BR_STT_CRED_CVE = 3 THEN 4 
        WHEN BR_STT_CRED_CVE = 1 THEN 2 ELSE 1 END INDICADOR,
    PARSE_DATE('%Y%j', SUBSTR(CAST(BR_SOLIC_CVE AS STRING), 1, 7)) AS DT_FCH_SOL,
    FORMAT_DATE("%Y%m", DATE(((SELECT PARSE_DATE("%Y%j", SUBSTR(CAST(BR_SOLIC_CVE AS STRING), 1, 7)))))) DT_FEC_SOL,
    FROM crp-pro-dwh-semanticagold.EIL_DP_VDWH.VFAC_OMDM_FLUJO
    WHERE FCH_CARGA >= DATE_ADD(DATE_TRUNC(CURRENT_DATE('America/Mexico_City'), YEAR),INTERVAL -5 YEAR)
  )
  WHERE rn=1
),

OMDM_FLUJO_CHARS AS (
  SELECT 
    BR_SOLIC_CVE,
    BR_TIPO,
    BR_ORG,
		MAX(BR_ORG_EXISTE) AS BR_ORG_EXISTE,
		MAX(BR_NUM_CONSULTA_BURO) AS BR_NUM_CONSULTA_BURO,
		MAX(LOG_CVE) AS LOG_CVE,
		MAX(SYS_FTE) AS SYS_FTE,
		MAX(BR_MODULO_SCORE_CVE) AS BR_MODULO_SCORE_CVE,
		MAX(BR_TIPO_CLIE_CVE) AS BR_TIPO_CLIE_CVE,
		MAX(BR_TASA_CVE) AS BR_TASA_CVE,
		MAX(BR_TIPO_BURO_CONSULTA_CVE) AS BR_TIPO_BURO_CONSULTA_CVE,
		MAX(BR_IMP_LIM_CRED_APROB) AS BR_IMP_LIM_CRED_APROB,
    MAX(CASE WHEN BR_FLUJO_CVE = 3 AND BR_STT_CRED_CVE = 2 THEN 1 ELSE 0 END) AS FLG_FRAUD,
    MAX(CASE WHEN BR_REGLA_CVE IN (96, 97, 92, 94) THEN 1 ELSE 0 END) AS FLG_VERIF_TEL,
    MAX(CASE WHEN BR_REGLA_CVE IN (93) THEN 1 ELSE 0 END) AS FLG_VERIF_DOC,
    MAX(CASE WHEN BR_REGLA_CVE IN (20) THEN 1 ELSE 0 END) AS FLG_VERIF_QQ,
    MAX(CASE WHEN BR_REGLA_CVE IN (92) THEN 1 ELSE 0 END) AS FLG_LINEA_BAJA
  FROM crp-pro-dwh-semanticagold.EIL_DP_VDWH.VFAC_OMDM_FLUJO
  WHERE FCH_CARGA >= DATE_ADD(DATE_TRUNC(CURRENT_DATE('America/Mexico_City'), YEAR),INTERVAL -5 YEAR)
  GROUP BY 1,2,3
),

