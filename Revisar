      THEN BR_IMP_INGRESO_FACILITADO
      WHEN BR_MODULO_SCORE_DES IN ('SC_SUBURBIATHINFILE','SC_THINFILE','SC_THINFILE_LPC','SC_THINFILE_SUBURBIAVISA')
      THEN BR_IMP_SDO_CTA_ABIERTA
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD1_THINREV_SIM','SCORECARD1_THINREV_SIM_SBB')
      THEN SegmentoScore
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD2_THICKREVAGELT30_SIM','SCORECARD2_THICKREVAGELT30_SIM_SBB')
      THEN SegmentoScore
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD3_THICKREVAGEGE30_SIM','SCORECARD3_THICKREVAGEGE30_SIM_SBB')
      THEN SegmentoScore
      WHEN BR_MODULO_SCORE_DES = 'SCORECARD_LPCPUROS2020'
      THEN SegmentoScore
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_NOHITDILISA_CONTL_2020','SCORECARD_NOHITDILISA_CONTL_2020SEL')
      THEN SegmentoScore
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_NOHITDILISA_SINTL_2020','SCORECARD_NOHITDILISA_SINTL_2020SEL')
      THEN SegmentoScore
      WHEN BR_MODULO_SCORE_DES IN ('SCORECARD_SUBURBIANOHIT_CONTL_2021','SCORECARD_SUBURBIANOHIT_CONTL_2021SEL')
