--- TABLAS FINALES ---
CTA_ALTA AS (
	SELECT * EXCEPT(rn)
	FROM (
		SELECT 
      *,
      ROW_NUMBER() OVER (PARTITION BY CTA_CVE ORDER BY FLG_PIF DESC) as rn
		FROM (
			SELECT 
        a.*,
        b.CTE_CVE_UNICO,
        CASE WHEN b.IND_TIT='1' THEN 1 ELSE 0 END AS FLG_TIT,
        CASE WHEN c.CTA_CVE IS NOT NULL THEN 1 ELSE 0 END AS FLG_PIF			
			FROM DIM_CTA_SDO a
			LEFT JOIN CLIE_UNICO b
			ON a.CTA_CVE = b.CTA_CVE
			LEFT JOIN POLIZAS c
			ON a.CTA_CVE = c.CTA_CVE
		)
	) WHERE rn = 1
),

VDIM_NEGFIN_ZONAS_SBB AS (
  SELECT * EXCEPT(rn)
  FROM (
    SELECT 
      *,
      ROW_NUMBER() OVER (PARTITION BY TDA_CVE ORDER BY ANIO DESC, MES DESC) as rn
    FROM crp-pro-dwh-semanticagold.MUS_PRO_DWH_VIEWS_ODS.VDIM_NEGFIN_ZONAS_SBB
  )
